generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    // url      = env("DATABASE_URL")
}

// ------ Models ------ 

model User {
    id            String   @id @default(uuid())
    email         String   @unique
    password_hash String
    name          String
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    project Project[]
}

model Project {
    id         String    @id @default(uuid())
    user_id    String
    name       String
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    user User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
    form Form[]
}

model Form {
    id                 String    @id @default(uuid())
    project_id         String
    name               String
    slug               String    @unique
    api_key            String    @unique
    config             Json
    notification_email String?
    is_active          Boolean   @default(true)
    deleted_at         DateTime?
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt

    project    Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)
    submission Submission[]
}

model Submission {
    id         String    @id @default(uuid())
    form_id    String
    data       Json
    ip_address String
    user_agent String
    deleted_at DateTime?
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt

    form Form @relation(fields: [form_id], references: [id], onDelete: Restrict)

    @@index([form_id, created_at])
}
