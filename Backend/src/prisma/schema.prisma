generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ------ Enum ------ 

enum NotificationStatus {
    PENDING
    SENT
    FAILED
}

enum WebhookDeliveryStatus {
    PENDING
    SENT
    FAILED
}

// ------ Models ------ 

model User {
    id            String   @id @default(uuid())
    email         String   @unique
    password_hash String
    name          String
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    project       Project[]
    refreshTokens RefreshToken[]
}

model RefreshToken {
    id         String    @id @default(uuid())
    user_id    String
    token_hash String
    expires_at DateTime
    revoked_at DateTime?
    created_at DateTime  @default(now())

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Project {
    id         String    @id @default(uuid())
    user_id    String
    name       String
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
    form             Form[]
    webhookEndpoints WebhookEndpoint[]
}

model Form {
    id                 String    @id @default(uuid())
    project_id         String
    name               String
    slug               String    @unique
    api_key            String    @unique
    config             Json
    notification_email String?
    is_active          Boolean   @default(true)
    deleted_at         DateTime?
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt

    project    Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)
    submission Submission[]
}

model Submission {
    id         String    @id @default(uuid())
    form_id    String
    data       Json
    ip_address String
    user_agent String
    deleted_at DateTime?
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt

    form             Form              @relation(fields: [form_id], references: [id], onDelete: Restrict)
    notificationLogs NotificationLog[]

    @@index([form_id, created_at])
}

model NotificationLog {
    id            String             @id @default(uuid())
    submission_id String
    type          String
    status        NotificationStatus @default(PENDING)
    attempts      Int                @default(0)
    last_error    String?
    created_at    DateTime           @default(now())
    sent_at       DateTime?

    submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
}

model WebhookEndpoint {
    id         String   @id @default(uuid())
    project_id String
    url        String
    secret     String
    events     String[] @default(["Submitted.created"])
    is_active  Boolean  @default(true)
    created_at DateTime @default(now())

    project         Project           @relation(fields: [project_id], references: [id], onDelete: Restrict)
    webhookDelivery WebhookDelivery[]
}

model WebhookDelivery {
    id                   String                @id @default(uuid())
    webhook_endpoint_id  String
    event_type           String
    payload              Json
    status               WebhookDeliveryStatus @default(PENDING)
    attempts             Int                   @default(0)
    response_status_code Int?
    created_at           DateTime              @default(now())
    delivered_at         DateTime

    webhookEndpoint WebhookEndpoint? @relation(fields: [webhook_endpoint_id], references: [id], onDelete: Cascade)
}
