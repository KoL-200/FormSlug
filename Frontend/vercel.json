{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://formslug.onrender.com/api/:path*"
        },
        {
            "source": "/f/:path*",
            "destination": "https://formslug.onrender.com/f/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}